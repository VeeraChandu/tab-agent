{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      { "changelogFile": "CHANGELOG.md" }
    ],
    [
      "@semantic-release/exec",
      { "prepareCmd": "node scripts/build.js ${nextRelease.version}" }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package.json", "src/manifest.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/tab-agent-*.zip", "label": "Tab Agent extension (zip) — load unpacked or drag into chrome://extensions" }
        ]
      }
    ],
    [
      "@semantic-release/exec",
      { "publishCmd": "node scripts/publishToChromeStore.js ${nextRelease.version}" }
    ]
  ]
}
